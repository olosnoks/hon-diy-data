{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["w3c-web-serial", "w3c-web-usb", "vitest/globals"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"], "@ui/*": ["src/ui/*"], "@platform/*": ["src/platform/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
