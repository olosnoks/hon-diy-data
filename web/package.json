{
  "name": "hondalog-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "hondalog as one React app: web (Web Serial), Android (TWA + WebUSB), installable PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "esptool-js": "^0.4.5",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.3.1",
    "sql.js": "^1.11.0",
    "uplot": "^1.6.31",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@types/w3c-web-serial": "^1.0.7",
    "@types/w3c-web-usb": "^1.0.10",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
