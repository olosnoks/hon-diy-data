CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM (the "R8" in N16R8) at 80 MHz holds the two frame buffers.
# malloc() stays in internal RAM; PSRAM is asked for by name.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Executable-in-place from PSRAM (selects CONFIG_SPIRAM_FETCH_INSTRUCTIONS and
# CONFIG_SPIRAM_RODATA): the app's code and read-only data run from PSRAM, so
# a flash write (an NVS commit, say) does not switch off the cache path to
# PSRAM while the RGB panel's interrupt reads frames from it. ESP-IDF
# recommends it for RGB panels with PSRAM frame buffers.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# RGB panel. The frame buffers are in PSRAM and reach the LCD peripheral
# through bounce buffers in internal RAM (main/port/port_esp32.c), so:
#  - the LCD interrupt that refills them must run while the flash cache is off
#    (an NVS write would otherwise freeze the picture for its duration);
#  - if a refill is ever late, restart the DMA at the next VSYNC instead of
#    leaving the picture shifted for good;
#  - 64-byte data cache lines move PSRAM pixels faster.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Per-core busy time for the HH_UI_PERF overlay. Costs one timer read per
# context switch.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# LVGL 9.2 is configured here, not by an lv_conf.h. sim/lv_conf.h is the
# simulator's copy of the same choices: keep the two in step.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_DPI_DEF=128
CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_THEME_MONO=n

# Console: UART0 only (the CH340C on the USB-C; sdkconfig.gps_p1 turns it off).
# GPIO19/20 are the S3's own USB pads and belong to the USB host port for the
# KKL cable (K-line plan A, components/hhcore/port/hh_kline_usb.c), so no
# console output may go to USB-Serial-JTAG, not even the secondary copy that
# ESP-IDF 5.3 turns on by default. The USB host library (component "usb",
# always built for the S3) switches the internal PHY to the OTG controller in
# host mode when the K-line code first opens the cable.
# An sdkconfig.esp32s3 made before this line keeps its old value: delete it.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# the chip's own brownout reset stays on (car supply)
CONFIG_ESP_BROWNOUT_DET=y
