#!/bin/sh
# Runs hondalog-tune (ROM tools) from this directory tree (uses ./.venv if install.sh made one).
HERE=$(dirname "$(readlink -f "$0")")/..
PY=python3
[ -x "$HERE/.venv/bin/python" ] && PY="$HERE/.venv/bin/python"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m hondalog.tuning "$@"
