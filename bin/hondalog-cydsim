#!/bin/sh
# Simulated handheld (CYD) on a pty: its USB serial stream. See: hondalog-cydsim --help
HERE=$(dirname "$(readlink -f "$0")")/..
PY=python3
[ -x "$HERE/.venv/bin/python" ] && PY="$HERE/.venv/bin/python"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m hondalog.handheld.cydsim "$@"
